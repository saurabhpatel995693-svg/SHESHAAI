// ── Export Chat Conversation Handlers ──
document.getElementById('export-chat-md-btn')?.addEventListener('click', () => {
  const messagesList = document.getElementById('messages-list');
  if (!messagesList || messagesList.children.length === 0) {
    toast('No chat messages to export', 'warning');
    return;
  }
  const text = Array.from(messagesList.children).map((el) => {
    const isUser = el.querySelector('.bg-primary, .text-link');
    const role = isUser ? 'User' : 'Assistant';
    const content = el.textContent || '';
    return `### ${role}:\n${content.trim()}\n`;
  }).join('\n---\n\n');

  const blob = new Blob([text], { type: 'text/markdown' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `SHESHAAI_Chat_${new Date().toISOString().slice(0,10)}.md`;
  a.click();
  toast('Chat exported to Markdown!','success');
});

document.getElementById('export-chat-txt-btn')?.addEventListener('click', () => {
  const messagesList = document.getElementById('messages-list');
  if (!messagesList || messagesList.children.length === 0) {
    toast('No chat messages to export', 'warning');
    return;
  }
  const text = Array.from(messagesList.children).map((el) => {
    const isUser = el.querySelector('.bg-primary, .text-link');
    const role = isUser ? 'User' : 'Assistant';
    const content = el.textContent || '';
    return `[${role}]:\n${content.trim()}\n`;
  }).join('\n========================================\n\n');

  const blob = new Blob([text], { type: 'text/plain' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `SHESHAAI_Chat_${new Date().toISOString().slice(0,10)}.txt`;
  a.click();
  toast('Chat exported to Text!','success');
});

fetch('/repo-knowledge.json')
