  googleBtn.style.opacity = '0.5';
  guestBtn.style.opacity = '0.5';
  
  status.classList.remove('hidden');
  status.textContent = 'Connecting to Google...';
  
  try {
    const provider = new firebase.auth.GoogleAuthProvider();
    provider.addScope('email');
    const result = await auth.signInWithPopup(provider);
    status.textContent = 'Signed in! Loading...';
    // onAuthStateChanged will call enterApp()
  } catch (e) {
    resetLoginButtons();
    
    const errorCode = e.code || 'unknown';
    const errorMsg = e.message || 'Unknown error';
    
    if (errorCode === 'auth/cancelled-popup-request') {
      status.textContent = 'Sign-in window already open. Please look for the Google window.';
      toast('Login window is already open', 'warning');
    } else if (errorCode === 'auth/popup-closed-by-user') {
      status.textContent = 'Sign-in cancelled. Please try again.';
      toast('Sign-in closed by user', 'info');
    } else if (errorCode === 'auth/popup-blocked') {
      status.textContent = 'Popup blocked by browser. Please allow popups and try again.';
      toast('Popup blocked - allow popups for this site', 'error');
    } else if (errorCode === 'auth/unauthorized-domain') {
      status.textContent = 'Domain not authorized. Please contact admin to add this domain to Firebase.';
      toast('Domain not authorized in Firebase Console', 'error');
    } else if (errorCode === 'auth/operation-not-allowed') {
      status.textContent = 'Google sign-in is not enabled. Please enable it in Firebase Console.';
      toast('Google sign-in not enabled in Firebase', 'error');
    } else {
      status.textContent = 'Error: ' + errorMsg;
      toast('Sign-in error: ' + errorMsg, 'error');
    }
    console.error('Auth error:', errorCode, errorMsg, e);
  }
};

