document.getElementById('nb-link-btn').onclick = async () => {
  const url = document.getElementById('nb-link-input').value.trim(); if(!url) return;
  toast('Extracting URL content...', 'info');

  let extractedTitle = '🔗 ' + url.replace(/^https?:\/\//,'').substring(0,40);
  let extractedContent = '';

  const isYouTube = url.includes('youtube.com') || url.includes('youtu.be');

  if (isYouTube) {
    // C2 audit fix: fetch the REAL transcript via /api/transcript (Supadata),
    // never a generic blurb from the video title.
    try {
      const res = await fetch('/api/transcript', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url })
      });
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.transcript && data.transcript.length > 30) {
        extractedTitle = '📺 ' + (data.title || 'YouTube Video');
        extractedContent = `=== VIDEO TRANSCRIPT START (${data.title || 'YouTube Video'}) ===\nTranscript language: ${data.language || 'unknown'}.\nBase ALL answers on the content below. Do NOT use general knowledge.\n"""\n${data.transcript}\n"""\n=== VIDEO TRANSCRIPT END ===`;
        console.log(`[NOTEBOOKS] YouTube transcript fetched: ${data.transcript.length} chars, language ${data.language || 'unknown'}`);
      } else {
        throw new Error(data.error || 'No captions/transcript available for this video');
      }
    } catch (e) {
      toast(`YouTube transcript failed: ${e.message}`, 'error');
      return;
    }
  }

  if (!extractedContent) {
    // Non-YouTube page: fetch real page text via r.jina.ai reader
    try {
      const jinaUrl = `https://r.jina.ai/${url}`;
      const res = await fetch(jinaUrl);
      if (res.ok) {
        const text = await res.text();
        if (text && text.length > 50 && !text.includes('CAPTCHA')) {
          extractedContent = text.substring(0, 15000);
          console.log(`[NOTEBOOKS] Web link content fetched: ${extractedContent.length} chars from r.jina.ai`);
        } else {
          throw new Error('Page content could not be extracted (blocked or empty)');
        }
      } else {
        throw new Error(`Page fetch failed (HTTP ${res.status})`);
      }
    } catch (e) {
      // C2 audit fix: clear error, NOT generic filler content
      toast(`Web link import failed: ${e.message}`, 'error');
      return;
    }
  }

  addNbSource(extractedTitle, extractedContent);
  document.getElementById('nb-link-input').value = '';
};

document.getElementById('nb-github-btn').onclick = async () => {
  const repo = document.getElementById('nb-github-repo').value.trim();
  const path = document.getElementById('nb-github-path').value.trim();
  if (!repo) return toast('Please enter a repository (owner/repo)', 'error');
  
  toast('Fetching from GitHub...', 'info');
  const headers = { 'Accept': 'application/vnd.github.v3+json' };
  const settings = JSON.parse(localStorage.getItem('betaai_settings') || '{}');
  const token = document.getElementById('s-github-token').value.trim() || settings.githubToken;
  if (token) headers['Authorization'] = `token ${token}`;
  // C5 audit: PAT is used for the API call AND for raw file downloads
  // (private repos 401 without it).
  const downloadHeaders = token ? { 'Authorization': `token ${token}` } : {};
  console.log(`[NOTEBOOKS] GitHub import: ${repo}/${path} | PAT present: ${!!token}`);

  try {
    const url = `https://api.github.com/repos/${repo}/contents/${path}`;
    const res = await fetch(url, { headers });
    if (!res.ok) throw new Error(`GitHub API: ${res.status} ${res.statusText}`);
    const data = await res.json();
    
    if (Array.isArray(data)) {
      // It's a directory, fetch up to 10 files
      let filesFetched = 0;
      for (const item of data) {
        if (item.type === 'file' && filesFetched < 10) {
          const fileRes = await fetch(item.download_url, { headers: downloadHeaders });
          if (fileRes.ok) {
            const text = await fileRes.text();
            addNbSource('🐙 ' + item.name, text);
            filesFetched++;
          }
        }
      }
      if (filesFetched === 0) {
        toast('No text/code files found in folder', 'warning');
      } else {
        toast(`Imported ${filesFetched} files from folder`, 'success');
      }
    } else if (data.type === 'file') {
      // It's a single file
      const fileRes = await fetch(data.download_url, { headers: downloadHeaders });
      if (!fileRes.ok) throw new Error('Failed to download raw file content');
      const text = await fileRes.text();
      addNbSource('🐙 ' + data.name, text);
      toast(`Imported ${data.name} successfully`, 'success');
    }
  } catch (e) {
    toast(`Failed to import: ${e.message}`, 'error');
  }
};

function addNbSource(name, content) {
  notebookSources.push({ name, content: content.substring(0, 10000) });
  document.getElementById('nb-actions').classList.remove('hidden');
  const box = document.getElementById('nb-sources');
  const el = document.createElement('div');
  el.className = 'flex items-center justify-between p-3 surface-card rounded-md border border-themed shadow-level-2 animate-fade-up';
  el.innerHTML = `
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-sm surface-card2 border border-themed flex items-center justify-center text-sm">📄</div>
      <div>
        <div class="text-xs font-medium text-themed-ink">${esc(name)}</div>
        <div class="text-[10px] font-mono text-themed-mute">${(content.length/1024).toFixed(1)} KB · ${content.split(/\s+/).length} words</div>
      </div>
    </div>
    <button class="rm-src text-themed-mute hover:text-error text-xs transition">✕</button>`;
  el.querySelector('.rm-src').onclick = () => {
    el.remove(); notebookSources = notebookSources.filter(s=>s.name!==name);
    if(!notebookSources.length) document.getElementById('nb-actions').classList.add('hidden');
