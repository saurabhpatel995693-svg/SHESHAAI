        } catch(e) { card.innerHTML = '<div class="markdown-body text-sm text-themed-ink">' + marked.parse(reply) + '</div>'; }
      } else {
        card.innerHTML = '<div class="markdown-body text-sm text-themed-ink">' + marked.parse(reply) + '</div>';
        card.querySelectorAll('pre code').forEach(block => hljs.highlightElement(block));
      }
    } catch(e) { card.innerHTML = `<span class="text-error text-sm">${esc(e.message)}</span>`; }
  };
});

/* ═══════════════════════════════════════════════════
   Web Search (AI-assisted)
   ═══════════════════════════════════════════════════ */
document.getElementById('search-go-btn').onclick = webSearch;
document.getElementById('search-query').onkeydown = e => { if(e.key==='Enter') webSearch(); };

async function performLiveWebSearch(query) {
  let resultsText = '';
  const cleanQ = encodeURIComponent(query);

  // 1. Live Web Search via serverless /api/search (Tavily/Serper/Brave)
  try {
    const searchRes = await fetch(`/api/search?q=${cleanQ}`);
    if (searchRes.ok) {
      const searchData = await searchRes.json();
      if (searchData.formattedText) {
        resultsText = searchData.formattedText;
      }
    }
  } catch(e) {
    console.warn('[CLIENT SEARCH] Server search endpoint fallback:', e.message);
  }

  // 2. Client-side fallback if server search was empty
  if (!resultsText) {
    try {
      const ddgUrl = `https://api.duckduckgo.com/?q=${cleanQ}&format=json&no_html=1&skip_disambig=1`;
      const ddgRes = await fetch(ddgUrl);
      if (ddgRes.ok) {
        const ddgData = await ddgRes.json();
        if (ddgData.AbstractText) {
          resultsText += `[Live Abstract]\nHeading: ${ddgData.Heading}\nSummary: ${ddgData.AbstractText}\nURL: ${ddgData.AbstractURL}\n\n`;
        }
      }
    } catch(e) {}
  }

  // 3. Live Video Search Integration (DuckDuckGo Video / YouTube Direct Embed Links)
  try {
    resultsText += `\n[Live Video Intelligence & Relevant Media]\n`;
    resultsText += `- Watch video results for "${query}": [Search YouTube Videos](https://www.youtube.com/results?search_query=${cleanQ})\n`;
    resultsText += `- Watch news coverage: [DuckDuckGo News & Video Stream](https://duckduckgo.com/?q=${cleanQ}&iax=videos&ia=videos)\n`;
  } catch(e) {}

  return resultsText;
}

async function webSearch() {
  const query = document.getElementById('search-query').value.trim(); if(!query) return;
  const box = document.getElementById('search-results');
  const card = document.createElement('div');
  card.className = 'surface-card rounded-lg border border-themed shadow-level-3 p-6 animate-fade-up space-y-4';
  card.innerHTML = '<span class="text-sm text-themed-mute animate-pulse">🔎 Searching live web, news feeds, and videos...</span>';
  box.prepend(card);

  try {
    const liveSearchData = await performLiveWebSearch(query);
    const systemPrompt = `You are a real-time web & news search assistant by SAURABH. Format your response with clear Markdown headers, bullet points, source citations, and direct video links. Be comprehensive and up-to-the-minute.\n\n${liveSearchData}`;

    const res = await fetchWithFailover(async (config) => {
      return await fetchChatCompletion(config, {
        messages: [
          { role: 'system', content: systemPrompt },
          { role: 'user', content: 'Search Query: ' + query }
        ]
      });
    });
    const data = await res.json();
    const reply = data.choices?.[0]?.message?.content || 'No search results found.';
    const cleanQ = encodeURIComponent(query);
    
    card.innerHTML = `
      <div class="flex items-center justify-between pb-3 border-b border-themed">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-link" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <span class="text-sm font-semibold text-themed-ink">${esc(query)}</span>
        </div>
        <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-cyan/10 text-cyan border border-cyan/20">⚡ Live Stream</span>
      </div>
      
      <!-- Video & Live News Quick Access Toolbar -->
      <div class="flex flex-wrap gap-2 p-3 surface-card2 rounded-md border border-themed text-xs">
        <span class="text-themed-mute font-mono text-[11px] flex items-center gap-1">🎥 Live Media:</span>
        <a href="https://www.youtube.com/results?search_query=${cleanQ}" target="_blank" rel="noopener" class="px-2.5 py-1 rounded bg-red-500/10 text-red-500 hover:bg-red-500/20 font-medium transition flex items-center gap-1">
          ▶ Watch YouTube Videos
        </a>
        <a href="https://news.google.com/search?q=${cleanQ}" target="_blank" rel="noopener" class="px-2.5 py-1 rounded bg-blue-500/10 text-blue-500 hover:bg-blue-500/20 font-medium transition flex items-center gap-1">
          📰 Google News Feed
        </a>
        <a href="https://duckduckgo.com/?q=${cleanQ}&iax=videos&ia=videos" target="_blank" rel="noopener" class="px-2.5 py-1 rounded bg-amber-500/10 text-amber-500 hover:bg-amber-500/20 font-medium transition flex items-center gap-1">
          🎬 Video Stream
        </a>
      </div>

      <div class="markdown-body text-sm text-themed-ink">${marked.parse(reply)}</div>`;
    card.querySelectorAll('pre code').forEach(block => hljs.highlightElement(block));
  } catch(e) { card.innerHTML = `<span class="text-error text-sm">Search Error: ${esc(e.message)}</span>`; }
}

/* ═══════════════════════════════════════════════════
   VibeCoding Split Canvas Drawer Engine
   ═══════════════════════════════════════════════════ */
function openVibeDrawer(code) {
  const drawer = document.getElementById('chat-vibe-drawer');
  const editor = document.getElementById('drawer-code-editor');
  const iframe = document.getElementById('drawer-preview-frame');
  if (!drawer || !editor || !iframe) return;

  editor.value = code;
  drawer.classList.remove('hidden');

  setTimeout(() => {
    try {
      const doc = iframe.contentWindow.document || iframe.contentDocument;
      doc.open();
      doc.write(code);
      doc.close();
    } catch(e) {
      console.error('Drawer preview error:', e);
    }
  }, 30);
}

document.getElementById('drawer-close')?.addEventListener('click', () => {
  document.getElementById('chat-vibe-drawer')?.classList.add('hidden');
});

document.getElementById('drawer-tab-preview')?.addEventListener('click', () => {
  document.getElementById('drawer-panel-preview')?.classList.remove('hidden');
  document.getElementById('drawer-panel-code')?.classList.add('hidden');
  document.getElementById('drawer-tab-preview')?.classList.add('btn-ink');
  document.getElementById('drawer-tab-preview')?.classList.remove('text-themed-body');
  document.getElementById('drawer-tab-code')?.classList.remove('btn-ink');
  document.getElementById('drawer-tab-code')?.classList.add('text-themed-body');
});

document.getElementById('drawer-tab-code')?.addEventListener('click', () => {
  document.getElementById('drawer-panel-preview')?.classList.add('hidden');
  document.getElementById('drawer-panel-code')?.classList.remove('hidden');
  document.getElementById('drawer-tab-code')?.classList.add('btn-ink');
  document.getElementById('drawer-tab-code')?.classList.remove('text-themed-body');
  document.getElementById('drawer-tab-preview')?.classList.remove('btn-ink');
  document.getElementById('drawer-tab-preview')?.classList.add('text-themed-body');
});

document.getElementById('drawer-popout')?.addEventListener('click', () => {
  const code = document.getElementById('drawer-code-editor')?.value || '';
  const w = window.open();
  w.document.write(code);
  w.document.close();
});

document.getElementById('drawer-refine-btn')?.addEventListener('click', () => {
  const input = document.getElementById('drawer-refine-input');
  const query = input?.value.trim();
  if (!query) return;
  input.value = '';
  document.getElementById('chat-input').value = `Refine VibeCoding Canvas app: ${query}`;
  sendChat();
});



