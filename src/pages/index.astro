async function fetchChatCompletion(config, bodyParams, signal = null) {
  // ALWAYS route through /api/chat server proxy — never call 3rd-party APIs
  // directly from the browser (CORS will block them).
  // The proxy uses x-custom-key, x-custom-base, x-custom-model headers
  // to forward to the user's chosen provider server-side.
  const endpoint = '/api/chat';

  const customKey   = getCustomKey();
  const customBase  = getCustomBase();
  const customModel = getCustomModel();

  const headers = {
    'Content-Type': 'application/json',
    'X-Title': 'SHESHAAI',
    'x-custom-key':   customKey,
    'x-custom-base':  customBase,
    'x-custom-model': customModel,
    'x-gemini-key':   localStorage.getItem('GEMINI_API_KEY') || localStorage.getItem('sheshaai_gemini_key') || '',
    'x-groq-key':     localStorage.getItem('sheshaai_groq_key') || '',
    'x-openrouter-key': localStorage.getItem('sheshaai_openrouter_key') || ''
  };

  const payload = {
    customKey,
    customBase,
    customModel,
    model: customModel || config.model || '',
    geminiKey:     localStorage.getItem('GEMINI_API_KEY') || localStorage.getItem('sheshaai_gemini_key') || '',
    groqKey:       localStorage.getItem('sheshaai_groq_key') || '',
    openrouterKey: localStorage.getItem('sheshaai_openrouter_key') || '',
    mode: config.mode === 'code' ? 'code' : 'general',
    ...bodyParams
  };

  // Log sanitized outgoing body (no API keys) so complexity/temperature/max_tokens
  // can be verified in DevTools — proves UI controls actually reach the backend.
  console.log('[OUTGOING /api/chat]', JSON.stringify({
    mode: payload.mode,
    complexity: payload.complexity || null,
    temperature: payload.temperature ?? null,
    max_tokens: payload.max_tokens ?? null,
    stream: payload.stream ?? false,
    messages: (payload.messages || []).map(m => m.role),
    lastUserMsg: String(payload.messages?.[payload.messages.length - 1]?.content || '').slice(0, 80)
  }));

  const res = await fetch(endpoint, {
    method: 'POST',
    signal: signal,
    headers: headers,
    body: JSON.stringify(payload)
  });

  if (!res.ok) {
    let errMsg = `HTTP error ${res.status}`;
    try {
      const errData = await res.json();
      errMsg = errData.error?.message || errData.message || errMsg;
    } catch(e) {}
    throw new Error(errMsg);
  }
  return res;
}

async function fetchWithFailover(apiCallFn, mode = 'general') {
  const selectedModel = getModel();

  // All requests always go through /api/chat — single attempt.
  // The server proxy handles routing to the user's custom provider.
  const attempts = [{
    label: 'BETAAI Server Proxy',
    base: '/api',
    model: selectedModel,
    mode: mode
  }];

  let lastError = null;
  for (let i = 0; i < attempts.length; i++) {
    const config = attempts[i];
    try {
      const response = await apiCallFn(config);
      if (!response) throw new Error(`No response from ${config.label}`);
      return response;
    } catch (err) {
      console.warn(`[BETAAI] ${config.label} failed:`, err.message);
      lastError = err;
    }
  }
  throw new Error(lastError ? lastError.message : 'AI request failed. Check your API key and settings.');
}


