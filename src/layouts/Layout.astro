---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
  noSidebars?: boolean;
}

const { 
  title = "Viblo AI - Tech Sharing & AI Assistant Community", 
  description = "A stark developer technical platform matching Vercel's design language, powered by Astro and Google Gemini AI.",
  wide = false,
  noSidebars = false
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Load Inter/Geist fonts from Google Fonts fallback -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  </head>
  <body class="bg-canvas-soft text-ink selection:bg-primary selection:text-canvas overflow-x-hidden font-sans">
    <!-- Atmospheric Mesh Gradient behind hero/top area -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-[1400px] h-[350px] overflow-hidden pointer-events-none z-0">
      <div class="mesh-gradient-bg w-full h-full"></div>
    </div>

    <!-- Main Navigation Bar -->
    <header class="sticky top-0 z-40 w-full bg-canvas/80 backdrop-blur-md border-b border-hairline h-16 transition-all duration-200">
      <div class="max-w-[1400px] mx-auto h-full px-4 md:px-6 flex items-center justify-between gap-4">
        <!-- Logo / Brand -->
        <a href="/" class="flex items-center gap-2.5 z-10 group" id="nav-logo-link">
          <!-- Stark Logo Emblem (Arrow pointing up representing growth) -->
          <div class="w-8 h-8 bg-primary rounded-md flex items-center justify-center transition-transform group-hover:scale-105 duration-200 shadow-level-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="12" y1="19" x2="12" y2="5"></line>
              <polyline points="5 12 12 5 19 12"></polyline>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-body-sm-strong font-semibold tracking-tight text-ink">SHESH<span class="bg-clip-text text-transparent bg-gradient-to-r from-emerald-500 to-cyan-500">AAI</span></span>
            <span class="text-[10px] font-mono text-mute leading-none tracking-widest uppercase">AI Study & Coding Platform</span>
          </div>
        </a>

        <!-- Middle space (removed search bar) -->
        <div class="hidden md:flex flex-1"></div>

        <!-- Right Side Nav Actions -->
        <div class="flex items-center gap-2.5">
          <!-- Daily Quota Badge -->
          <div id="nav-quota-badge" class="hidden sm:flex items-center gap-1.5 h-8 px-2.5 rounded-pill-sm border border-hairline bg-canvas text-[11px] font-mono text-body cursor-help" title="Daily Guest Quota — Add your Gemini API Key for Unlimited">
            <span id="quota-badge-icon">⚡</span>
            <span id="quota-badge-text" class="font-semibold text-emerald-600">10/10 Free</span>
          </div>

          <!-- Theme Toggle Button -->
          <button 
            type="button" 
            id="theme-toggle-btn"
            title="Toggle Light / Dark Theme"
            class="flex items-center justify-center w-8 h-8 rounded-full border border-hairline bg-canvas hover:border-hairline-strong transition-all cursor-pointer text-sm"
          >
            <span id="theme-toggle-icon">🌙</span>
          </button>

          <!-- Interactive Onboarding Tour Button -->
          <button 
            type="button" 
            id="start-tour-btn"
            title="Interactive Platform Tour"
            class="flex items-center justify-center w-8 h-8 rounded-full border border-hairline bg-canvas hover:border-hairline-strong transition-all cursor-pointer text-xs font-mono font-bold text-violet hover:bg-violet-soft/20"
          >
            ❓
          </button>

          <!-- API Key Status Pill -->
          <button 
            type="button" 
            id="api-settings-trigger"
            class="flex items-center gap-2 h-8 px-3 rounded-pill-sm border border-hairline bg-canvas hover:border-hairline-strong transition-all duration-200 shadow-level-2 group"
          >
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75" id="api-indicator-ping"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500" id="api-indicator-dot"></span>
            </span>
            <span class="text-[12px] font-mono text-body group-hover:text-ink">AI Engine: <span id="api-indicator-text" class="text-red-500 font-semibold">Offline</span></span>
          </button>

          <!-- Nav Button -->
          <a 
            href="/health"
            id="nav-health-btn"
            class="flex items-center justify-center h-8 px-3 bg-rose-600 text-white rounded-sm text-[13px] font-medium hover:bg-rose-700 transition-colors duration-200 shadow-level-3"
          >
            ❤️ Health
          </a>
          <a 
            href="/kiddienotes"
            id="nav-kiddie-btn"
            class="flex items-center justify-center h-8 px-3 bg-primary text-on-primary rounded-sm text-[13px] font-medium hover:bg-black transition-colors duration-200 shadow-level-3"
          >
            🎒 KiddieNotes
          </a>
        </div>
      </div>
    </header>

    <!-- Main Container -->
    <div class="max-w-[1400px] mx-auto px-4 md:px-6 py-6 md:py-8 relative z-10 min-h-[calc(100vh-64px)] flex flex-col">
      <div class="flex-1 grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Left Sidebar Navigation -->
        {!noSidebars && (
          <aside class="lg:col-span-2 hidden lg:flex flex-col gap-6" id="left-sidebar">
            <nav class="flex flex-col gap-1">
              <a 
                href="/" 
                class="flex items-center gap-3 px-3 py-2 text-body hover:text-ink hover:bg-canvas-soft-2 rounded-sm text-body-sm transition-colors duration-150"
                id="menu-feed"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 19h16a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z"></path>
                  <path d="M12 11h4"></path>
                  <path d="M12 15h4"></path>
                  <path d="M8 11h.01"></path>
                  <path d="M8 15h.01"></path>
                </svg>
                Post Feed
              </a>
              <a 
                href="/questions" 
                class="flex items-center gap-3 px-3 py-2 text-body hover:text-ink hover:bg-canvas-soft-2 rounded-sm text-body-sm transition-colors duration-150"
                id="menu-questions"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path>
                  <line x1="12" y1="17" x2="12.01" y2="17"></line>
                </svg>
                Q&A Forum
              </a>
              <a 
                href="/translations" 
                class="flex items-center gap-3 px-3 py-2 text-body hover:text-ink hover:bg-canvas-soft-2 rounded-sm text-body-sm transition-colors duration-150"
                id="menu-translations"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                  <path d="M8 9h8"></path>
                  <path d="M8 13h6"></path>
                </svg>
                Translations
              </a>
              <a 
                href="/ai-assistant" 
                class="flex items-center gap-3 px-3 py-2 text-violet hover:text-violet-deep hover:bg-violet-soft/20 rounded-sm text-body-sm-strong transition-colors duration-150 font-medium"
                id="menu-ai"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                  <polyline points="2 17 12 22 22 17"></polyline>
                  <polyline points="2 12 17 22 12"></polyline>
                </svg>
                AI Assistant
              </a>
              <a 
                href="/health" 
                class="flex items-center gap-3 px-3 py-2 text-rose-600 hover:text-rose-700 hover:bg-rose-50 rounded-sm text-body-sm-strong transition-colors duration-150 font-medium"
                id="menu-health"
              >
                <span class="text-sm">❤️</span>
                Health Studio
              </a>
              <hr class="border-hairline my-3" />
              <button 
                type="button"
                id="menu-key-btn"
                class="flex items-center gap-3 px-3 py-2 text-mute hover:text-ink rounded-sm text-[13px] text-left w-full transition-colors duration-150 font-mono"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                Config API Key
              </button>
            </nav>
          </aside>
        )}

        <!-- Main Workspace Area -->
        <main class={`${noSidebars ? 'lg:col-span-12' : (wide ? 'lg:col-span-10' : 'lg:col-span-7')} min-w-0 flex flex-col gap-6`}>
          <slot />
        </main>

        <!-- Right Sidebar Widgets -->
        {!noSidebars && !wide && (
          <aside class="lg:col-span-3 hidden lg:flex flex-col gap-6" id="right-sidebar">
            <!-- Sidebar Widgets get injected here on pages -->
            <slot name="sidebar" />
          </aside>
        )}
      </div>

      <!-- Footer Bar -->
      <footer class="mt-auto pt-16 pb-8 border-t border-hairline flex flex-col md:flex-row items-center justify-between gap-4 text-caption text-mute font-mono">
        <div>
          <span>&copy; 2026 SHESHAAI. Made by SAURABH.</span>
        </div>
        <div class="flex items-center gap-4">
          <a href="#" class="hover:text-ink transition-colors">Methodology</a>
          <span>&bull;</span>
          <a href="#" class="hover:text-ink transition-colors">Privacy Policy</a>
          <span>&bull;</span>
          <button type="button" class="hover:text-ink transition-colors text-left" id="reset-db-btn">Reset Application Data</button>
        </div>
      </footer>
    </div>

    <!-- API CONFIG MODAL -->
    <div 
      id="api-modal-overlay" 
      class="fixed inset-0 z-50 bg-primary/40 backdrop-blur-sm hidden items-center justify-center p-4 transition-all duration-300"
    >
      <div 
        class="bg-canvas border border-hairline w-full max-w-md rounded-lg shadow-level-5 p-6 transform scale-95 transition-all duration-300 flex flex-col gap-4"
        id="api-modal-card"
      >
        <div class="flex items-center justify-between border-b border-hairline pb-3">
          <h2 class="text-display-sm tracking-tight text-ink font-semibold flex items-center gap-2">
            <svg class="text-violet" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            API Configurations
          </h2>
          <button 
            type="button" 
            id="api-modal-close" 
            class="text-mute hover:text-ink rounded-full w-6 h-6 flex items-center justify-center hover:bg-canvas-soft-2 transition-all"
          >
            &times;
          </button>
        </div>
        
        <p class="text-body-sm text-body leading-relaxed">
          Enter your <strong class="text-ink">Google Gemini API Key</strong> to unlock unlimited KiddieNotes study packs, AI responses, and generation across SHESHAAI.
        </p>
        
        <div class="flex flex-col gap-2">
          <label for="gemini-key-input" class="text-caption-mono text-mute font-medium">Gemini API Key</label>
          <div class="relative">
            <input 
              type="password" 
              id="gemini-key-input" 
              placeholder="AIzaSy..." 
              class="w-full h-10 bg-canvas-soft border border-hairline rounded-sm px-3 pr-10 text-body-sm text-ink placeholder:text-mute focus:outline-none focus:border-hairline-strong transition-colors"
            />
            <button 
              type="button" 
              id="toggle-key-visibility" 
              class="absolute right-3 top-3 text-mute hover:text-body text-xs font-mono select-none"
            >
              SHOW
            </button>
          </div>
          <span class="text-[11px] text-mute font-mono">
            Stored locally in your browser cache. Never shared or sent to third parties.
          </span>
        </div>

        <div class="flex items-center justify-end gap-3 pt-3 border-t border-hairline mt-2">
          <button 
            type="button" 
            id="clear-api-key"
            class="h-9 px-4 rounded-pill border border-hairline text-body text-[13px] font-medium hover:border-error hover:text-error transition-all"
          >
            Clear Key
          </button>
          <button 
            type="button" 
            id="save-api-key"
            class="h-9 px-4 bg-primary text-on-primary rounded-pill text-[13px] font-medium hover:bg-black transition-all"
          >
            Save Changes
          </button>
        </div>
      </div>
    </div>

    <!-- INTERACTIVE ONBOARDING TOUR MODAL -->
    <div 
      id="onboarding-tour-modal" 
      class="fixed inset-0 z-50 bg-primary/50 backdrop-blur-sm hidden items-center justify-center p-4 transition-all duration-300"
    >
      <div 
        class="bg-canvas border border-hairline w-full max-w-lg rounded-xl shadow-level-5 p-6 flex flex-col gap-5 transform scale-95 transition-all"
      >
        <div class="flex items-center justify-between border-b border-hairline pb-3">
          <div class="flex items-center gap-2">
            <span class="text-xl" id="tour-step-icon">🌟</span>
            <h3 class="text-display-sm text-ink font-semibold" id="tour-step-title">Welcome to SHESHAAI!</h3>
          </div>
          <button type="button" id="tour-close-btn" class="text-mute hover:text-ink text-xl font-bold">&times;</button>
        </div>

        <div class="space-y-3" id="tour-step-content">
          <p class="text-body-sm text-body leading-relaxed" id="tour-step-desc">
            SHESHAAI is your all-in-one AI platform for developer discussions, code assistance, and interactive K-12 study packs. Let's take a quick 30-second tour!
          </p>
          <div class="p-3 bg-canvas-soft border border-hairline rounded-md text-xs font-mono text-ink" id="tour-step-tip">
            💡 Tip: Click the 🔑 AI Engine button in the navbar anytime to add your own Gemini key for unlimited generation!
          </div>
        </div>

        <div class="flex items-center justify-between pt-3 border-t border-hairline">
          <span class="text-caption-mono text-mute" id="tour-step-indicator">Step 1 of 3</span>
          <div class="flex items-center gap-2">
            <button type="button" id="tour-skip-btn" class="px-3 py-1.5 text-xs font-mono text-mute hover:text-ink">Skip</button>
            <button type="button" id="tour-next-btn" class="px-4 py-2 bg-primary text-on-primary rounded-sm text-xs font-mono font-semibold hover:bg-black transition">
              Next →
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Client-Side Key Management Script -->
    <script>
      async function checkServerHealth() {
        // Lightweight health check: POST to /api/chat with a minimal ping
        // The server should respond even if it just falls back to built-in engine
        try {
          const res = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ messages: [{ role: 'user', content: 'ping' }], mode: 'general' })
          });
          // Any response (even 429 rate-limit or 200 OK) means server is reachable
          return true;
        } catch {
          return false;
        }
      }

      async function initApiKeyStatus() {
        // Check ALL possible key storage locations (unified)
        const key = localStorage.getItem('GEMINI_API_KEY') || localStorage.getItem('sheshaai_user_key') || localStorage.getItem('sheshaai_gemini_key') || localStorage.getItem('betaai_custom_key') || '';
        const indicators = {
          ping: document.getElementById('api-indicator-ping'),
          dot: document.getElementById('api-indicator-dot'),
          text: document.getElementById('api-indicator-text')
        };
        const keyInput = document.getElementById('gemini-key-input') as HTMLInputElement;

        if (key && key.trim().length > 0) {
          // Custom key is set — engine is Active
          if (indicators.ping) indicators.ping.className = "animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75";
          if (indicators.dot) indicators.dot.className = "relative inline-flex rounded-full h-2 w-2 bg-emerald-500";
          if (indicators.text) {
            indicators.text.textContent = "Active";
            indicators.text.className = "text-emerald-500 font-semibold";
          }
          if (keyInput) keyInput.value = key;
          return;
        }

        // No custom key — check server health; server has its own key pool
        const serverOnline = await checkServerHealth();
        if (serverOnline) {
          if (indicators.ping) indicators.ping.className = "animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75";
          if (indicators.dot) indicators.dot.className = "relative inline-flex rounded-full h-2 w-2 bg-emerald-500";
          if (indicators.text) {
            indicators.text.textContent = "Online (Server Pool)";
            indicators.text.className = "text-emerald-500 font-semibold";
          }
        } else {
          if (indicators.ping) indicators.ping.className = "animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75";
          if (indicators.dot) indicators.dot.className = "relative inline-flex rounded-full h-2 w-2 bg-red-500";
          if (indicators.text) {
            indicators.text.textContent = "Offline";
            indicators.text.className = "text-red-500 font-semibold";
          }
        }
        if (keyInput) keyInput.value = "";
      }

      const trigger = document.getElementById('api-settings-trigger');
      const overlay = document.getElementById('api-modal-overlay');
      const closeBtn = document.getElementById('api-modal-close');
      const saveBtn = document.getElementById('save-api-key');
      const clearBtn = document.getElementById('clear-api-key');
      const keyInput = document.getElementById('gemini-key-input') as HTMLInputElement;
      const toggleVis = document.getElementById('toggle-key-visibility');

      function openModal() {
        if (overlay) {
          overlay.classList.remove('hidden');
          overlay.classList.add('flex');
          const key = localStorage.getItem('GEMINI_API_KEY') || localStorage.getItem('sheshaai_gemini_key') || localStorage.getItem('sheshaai_user_key') || localStorage.getItem('betaai_custom_key') || "";
          if (keyInput) keyInput.value = key;
        }
      }

      function closeModal() {
        if (overlay) {
          overlay.classList.add('hidden');
          overlay.classList.remove('flex');
        }
      }

      if (trigger) trigger.addEventListener('click', openModal);
      if (closeBtn) closeBtn.addEventListener('click', closeModal);
      if (overlay) {
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay) closeModal();
        });
      }

      if (toggleVis && keyInput) {
        toggleVis.addEventListener('click', () => {
          if (keyInput.type === 'password') {
            keyInput.type = 'text';
            toggleVis.textContent = 'HIDE';
          } else {
            keyInput.type = 'password';
            toggleVis.textContent = 'SHOW';
          }
        });
      }

      if (saveBtn && keyInput) {
        saveBtn.addEventListener('click', async () => {
          const val = keyInput.value.trim();
          if (val) {
            localStorage.setItem('GEMINI_API_KEY', val);
            localStorage.setItem('sheshaai_gemini_key', val);
            localStorage.setItem('sheshaai_user_key', val);
            localStorage.setItem('betaai_custom_key', val);
          } else {
            localStorage.removeItem('GEMINI_API_KEY');
            localStorage.removeItem('sheshaai_gemini_key');
            localStorage.removeItem('sheshaai_user_key');
            localStorage.removeItem('betaai_custom_key');
          }
          await initApiKeyStatus();
          closeModal();
          window.dispatchEvent(new Event('api-key-updated'));
        });
      }

      if (clearBtn) {
        clearBtn.addEventListener('click', async () => {
          localStorage.removeItem('GEMINI_API_KEY');
          localStorage.removeItem('sheshaai_gemini_key');
          localStorage.removeItem('sheshaai_user_key');
          localStorage.removeItem('betaai_custom_key');
          if (keyInput) keyInput.value = "";
          await initApiKeyStatus();
          closeModal();
          window.dispatchEvent(new Event('api-key-updated'));
        });
      }

      const resetDbBtn = document.getElementById('reset-db-btn');
      if (resetDbBtn) {
        resetDbBtn.addEventListener('click', (e) => {
          e.preventDefault();
          if (confirm('Reset all application data?')) {
            localStorage.clear();
            window.location.reload();
          }
        });
      }

      // ── Dark / Light Theme Toggle Manager ──
      function initTheme() {
        const savedTheme = localStorage.getItem('sheshaai_theme') || 'dark';
        document.documentElement.setAttribute('data-theme', savedTheme);
        const iconEl = document.getElementById('theme-toggle-icon');
        if (iconEl) {
          iconEl.textContent = savedTheme === 'dark' ? '🌞' : '🌙';
        }
      }

      document.getElementById('theme-toggle-btn')?.addEventListener('click', () => {
        const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', newTheme);
        localStorage.setItem('sheshaai_theme', newTheme);
        const iconEl = document.getElementById('theme-toggle-icon');
        if (iconEl) {
          iconEl.textContent = newTheme === 'dark' ? '🌞' : '🌙';
        }
      });

      // ── Daily Quota & Key Sync ──
      function updateQuotaDisplay() {
        const key = localStorage.getItem('GEMINI_API_KEY') || localStorage.getItem('sheshaai_user_key') || localStorage.getItem('sheshaai_gemini_key') || '';
        const badgeText = document.getElementById('quota-badge-text');
        if (!badgeText) return;

        if (key && key.trim().length > 0) {
          badgeText.textContent = '⚡ Unlimited';
          badgeText.className = 'font-semibold text-emerald-600';
        } else {
          try {
            const raw = localStorage.getItem('sheshaai_daily_usage');
            const today = new Date().toISOString().slice(0, 10);
            let count = 0;
            if (raw) {
              const parsed = JSON.parse(raw);
              if (parsed.date === today) count = parsed.count;
            }
            const remaining = Math.max(0, 10 - count);
            badgeText.textContent = `⚡ ${remaining}/10 Free`;
            badgeText.className = remaining > 3 ? 'font-semibold text-emerald-600' : 'font-semibold text-amber-600';
          } catch {
            badgeText.textContent = '⚡ 10/10 Free';
          }
        }
      }

      window.addEventListener('api-key-updated', updateQuotaDisplay);
      window.addEventListener('quota-updated', updateQuotaDisplay);
      window.addEventListener('storage', updateQuotaDisplay);

      // ── Interactive Onboarding Tour Manager ──
      const tourSteps = [
        {
          title: "Welcome to SHESHAAI!",
          icon: "🌟",
          desc: "SHESHAAI is your developer hub for technical Q&A, translation, coding tools, and KiddieNotes K-12 study engine.",
          tip: "💡 Tip: Click the 🔑 AI Engine status button in the header anytime to configure your Gemini API Key."
        },
        {
          title: "🎒 KiddieNotes AI Studio",
          icon: "🎒",
          desc: "Convert YouTube videos, classroom audio, or PDF notes into active recall quizzes, 3D flashcards, and arcade revision games.",
          tip: "💡 Tip: Use the grade level filter chips (Nursery to 12th) to adjust note complexity instantly!"
        },
        {
          title: "🔑 Unlimited Generations & Theme",
          icon: "⚡",
          desc: "Guests receive 10 free generations per day. Enter your own free Google Gemini API key to unlock 100% unlimited access across the platform.",
          tip: "💡 Tip: Click the 🌞/🌙 toggle in the top right to switch between Dark and Light mode!"
        }
      ];

      let tourCurrentStep = 0;

      function renderTourStep(stepIdx) {
        const step = tourSteps[stepIdx];
        if (!step) return;
        document.getElementById('tour-step-icon').textContent = step.icon;
        document.getElementById('tour-step-title').textContent = step.title;
        document.getElementById('tour-step-desc').textContent = step.desc;
        document.getElementById('tour-step-tip').textContent = step.tip;
        document.getElementById('tour-step-indicator').textContent = `Step ${stepIdx + 1} of ${tourSteps.length}`;
        document.getElementById('tour-next-btn').textContent = stepIdx === tourSteps.length - 1 ? 'Get Started! 🎉' : 'Next →';
      }

      function openTour() {
        tourCurrentStep = 0;
        renderTourStep(0);
        const modal = document.getElementById('onboarding-tour-modal');
        if (modal) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
        }
      }

      function closeTour() {
        const modal = document.getElementById('onboarding-tour-modal');
        if (modal) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
        localStorage.setItem('sheshaai_onboarded', 'true');
      }

      document.getElementById('start-tour-btn')?.addEventListener('click', openTour);
      document.getElementById('tour-close-btn')?.addEventListener('click', closeTour);
      document.getElementById('tour-skip-btn')?.addEventListener('click', closeTour);
      document.getElementById('tour-next-btn')?.addEventListener('click', () => {
        if (tourCurrentStep < tourSteps.length - 1) {
          tourCurrentStep++;
          renderTourStep(tourCurrentStep);
        } else {
          closeTour();
        }
      });

      // Auto-trigger tour for first-time visitors after 1.5 seconds
      window.addEventListener('DOMContentLoaded', () => {
        initTheme();
        updateQuotaDisplay();
        if (!localStorage.getItem('sheshaai_onboarded')) {
          setTimeout(openTour, 1500);
        }
      });

      (async () => { await initApiKeyStatus(); })();
      document.addEventListener('astro:after-swap', async () => { 
        initTheme();
        updateQuotaDisplay();
        await initApiKeyStatus(); 
      });
    </script>
  </body>
</html>
